# MSMEase AI Compliance Assistant Configuration

# ---------------------------------------------
# FAISS Vector Index Configuration
# ---------------------------------------------
FAISS_INDEX_PATH=data/faiss_index.bin

# ---------------------------------------------
# Embedding Model Provider
# Options: "local" (default fallback, offline 384-d feature vectorizer), "gemini", "openai"
# ---------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=msmease-compliance-embed-384

# ---------------------------------------------
# LLM Answering Provider
# Options: "local" (grounded offline synthesizer), "gemini", "openai"
# Auto-detects if GEMINI_API_KEY or OPENAI_API_KEY is present
# ---------------------------------------------
LLM_PROVIDER=local

# Google Gemini API Key (Optional: for cloud embeddings and generative answers)
# GEMINI_API_KEY=AIzaSy...

# OpenAI API Key (Optional: for text-embedding-3-small and gpt-4o-mini)
# OPENAI_API_KEY=sk-...

# ---------------------------------------------
# Chunking & Retrieval Hyperparameters
# ---------------------------------------------
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# ---------------------------------------------
# Administrative Secret Key
# ---------------------------------------------
ADMIN_API_KEY=msmease-admin-secret-2026
